# Server
PORT=5000
CORS_ORIGIN=https://YOUR_CLOUDFRONT_FRONTEND_URL.cloudfront.net

# Database
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/pet_social

# Authentication
JWT_SECRET=your_random_secret_at_least_32_characters_long

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Email (Gmail App Password - NOT your actual Gmail password)
EMAIL=your_gmail@gmail.com
PASSWORD=your_gmail_app_password
EMAIL_USER=your_gmail@gmail.com